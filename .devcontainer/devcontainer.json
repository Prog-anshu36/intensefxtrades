{
  "name": "TradeFXBook",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "postCreateCommand": "pip install -r requirements.txt && python scripts/dataset_package.py restore",
  "postStartCommand": "nohup python backend/app.py > /tmp/tradefxbook.log 2>&1 &",
  "forwardPorts": [5050],
  "portsAttributes": {"5050": {"label": "TradeFXBook", "onAutoForward": "openBrowser", "visibility": "private"}},
  "remoteEnv": {"HOST": "0.0.0.0", "PORT": "5050"}
}
